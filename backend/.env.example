DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/homhive_dev
HOMHIVE_MEDIA_ROOT=C:\HomHiveData\media
HOMHIVE_HOUSEHOLD_TOKENS={"homhive_test_home":"REPLACE_WITH_RANDOM_SECRET"}
HOMHIVE_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
HOMHIVE_ENTITY_STORAGE=memory
NEBIUS_API_KEY=REPLACE_WITH_NEBIUS_KEY
NEBIUS_REASONING_MODEL=REPLACE_WITH_PUBLIC_NVIDIA_NEMOTRON_MODEL_ID
TAVILY_API_KEY=REPLACE_WITH_TAVILY_KEY

# Autonomous user flow. Set these only when Nebius, OpenAI and Anthropic keys/models are configured.
HOMHIVE_ENABLE_AUTONOMOUS_QUEUE=true
HOMHIVE_ENABLE_AUTONOMOUS_SCAN=true
HOMHIVE_ENABLE_OPEN_WORLD_PREVIEW=true
HOMHIVE_NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
HOMHIVE_OPENAI_REVIEW_MODEL=gpt-4.1-mini
HOMHIVE_ANTHROPIC_REVIEW_MODEL=claude-sonnet-4-5-20250929
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
